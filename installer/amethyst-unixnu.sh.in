#!/system/bin/sh
# SPDX-License-Identifier: BSD-2-Clause-Patent
# Amethyst UniXNU Partitioner @TOOL_VERSION@ - single-file terminal edition.
#
# Run this from a root shell INSIDE RECOVERY, either `adb shell` or the
# recovery's built-in terminal. It is not a flashable ZIP.
#
#   adb push amethyst-unixnu.sh /tmp/
#   adb shell
#   sh /tmp/amethyst-unixnu.sh            # guided: inspect -> plan -> apply
#
# The statically linked AArch64 helper is appended to this file after the
# __HELPER_PAYLOAD__ marker. It is extracted to RAM and checked against a
# pinned SHA-256 before it runs. Nothing is downloaded.
#
# Do not edit this file: the payload offset is counted from the end, so text
# edits are fine, but any change to the bytes after the marker breaks the hash.

HELPER_SHA256='@HELPER_SHA256@'
HELPER_SIZE='@HELPER_SIZE@'
TOOL_VERSION='@TOOL_VERSION@'

usage() {
    cat <<EOF
Amethyst UniXNU Partitioner $TOOL_VERSION (terminal edition)

Run as root inside recovery (adb shell or the recovery terminal):

  sh amethyst-unixnu.sh [options]                 guided inspect -> plan -> apply
  sh amethyst-unixnu.sh inspect [options]         read-only report
  sh amethyst-unixnu.sh plan [options]            create a plan bundle (no writes)
  sh amethyst-unixnu.sh apply  [--plan DIR]       apply a plan (destructive)
  sh amethyst-unixnu.sh verify  --plan DIR        read-only post-apply check
  sh amethyst-unixnu.sh recover --plan DIR        read-only stage/recovery summary
  sh amethyst-unixnu.sh selftest                  run the helper's built-in tests

Options:
  --dir DIR       where reports and plan bundles go
                  (default: /usb_otg, then /external_sd, then /tmp)
  --size GIB      unixnu size in GiB (default: asked, 16 suggested)
  --reserve MIB   unallocated gap after unixnu in MiB (default 1024)
  --plan DIR      plan bundle for apply/verify/recover (default: newest plan)
  -h, --help      show this help

Before applying: back up userdata and metadata, decrypt and mount /data
read-write, and keep the phone on the charger. Do not put this script or the
plan on /sdcard or /data - apply unmounts /data.
EOF
}

say()  { printf '%s\n' "$*"; }
hr()   { say '------------------------------------------------------------------'; }
stop() { printf '\nSTOP: %s\n' "$*" >&2; exit 1; }

ask() {
    # ask "prompt" default -> REPLY
    if [ -n "$2" ]; then
        printf '%s [%s]: ' "$1" "$2"
    else
        printf '%s: ' "$1"
    fi
    REPLY=''
    IFS= read -r REPLY || stop 'no input (run this from an interactive shell)'
    REPLY=$(printf '%s' "$REPLY" | tr -d '\r')
    [ -n "$REPLY" ] || REPLY=$2
}

ask_yes() {
    ask "$1 (y/N)" ''
    case "$REPLY" in y|Y|yes|YES|Yes) return 0 ;; *) return 1 ;; esac
}

# --------------------------------------------------------------------------
# Relocate to RAM. The shell keeps this file open while it runs; if it lives on
# /sdcard (userdata) that open file would stop apply from unmounting /data.
# --------------------------------------------------------------------------
SELF=$0
case "$SELF" in
    */*) ;;
    *) SELF=$(command -v -- "$SELF" 2>/dev/null || printf '%s' "$SELF") ;;
esac
[ -f "$SELF" ] || stop "cannot find this script on disk ($0); run it as: sh /path/to/amethyst-unixnu.sh"

RAMDIR=${TMPDIR:-/tmp}
if [ "${AMETHYST_UNIXNU_RELOCATED:-}" != 1 ]; then
    [ -d "$RAMDIR" ] || stop "$RAMDIR does not exist; recovery should provide a RAM /tmp"
    COPY="$RAMDIR/amethyst-unixnu.$$.sh"
    cp "$SELF" "$COPY" 2>/dev/null || stop "cannot copy this script to $RAMDIR"
    cd / || stop 'cannot cd /'
    AMETHYST_UNIXNU_RELOCATED=1
    AMETHYST_UNIXNU_ORIGIN=$SELF
    export AMETHYST_UNIXNU_RELOCATED AMETHYST_UNIXNU_ORIGIN
    exec sh "$COPY" "$@"
    stop 'cannot re-run from RAM'
fi
cd / || stop 'cannot cd /'
umask 022

# Only ever delete our own RAM copy, never the file the user ran.
drop_self() {
    case "$SELF" in "$RAMDIR"/amethyst-unixnu.*.sh) rm -f "$SELF" ;; esac
}

# --------------------------------------------------------------------------
# Arguments
# --------------------------------------------------------------------------
CMD=''
OPT_DIR=''
OPT_SIZE=''
OPT_RESERVE=''
OPT_PLAN=''
while [ $# -gt 0 ]; do
    case "$1" in
        -h|--help|help) usage; drop_self; exit 0 ;;
        --version) say "amethyst-unixnu $TOOL_VERSION"; drop_self; exit 0 ;;
        --dir)     [ $# -ge 2 ] || stop '--dir needs a directory'; OPT_DIR=$2; shift ;;
        --size)    [ $# -ge 2 ] || stop '--size needs a value'; OPT_SIZE=$2; shift ;;
        --reserve) [ $# -ge 2 ] || stop '--reserve needs a value'; OPT_RESERVE=$2; shift ;;
        --plan)    [ $# -ge 2 ] || stop '--plan needs a directory'; OPT_PLAN=$2; shift ;;
        guided|inspect|plan|apply|verify|recover|selftest)
            [ -z "$CMD" ] || stop "unexpected argument $1"
            CMD=$1 ;;
        *) stop "unknown argument $1 (try --help)" ;;
    esac
    shift
done
[ -n "$CMD" ] || CMD=guided

# --------------------------------------------------------------------------
# Extract and verify the helper into RAM
# --------------------------------------------------------------------------
RUN="$RAMDIR/amethyst-unixnu.run.$$"
rm -rf "$RUN"
mkdir -p "$RUN" || stop "cannot create $RUN"
chmod 700 "$RUN" 2>/dev/null
trap 'rm -rf "$RUN"; drop_self' EXIT
trap 'exit 130' INT TERM

case "$(uname -m)" in
    aarch64|arm64) ;;
    *) stop "unsupported architecture $(uname -m); run this on the phone, not the PC" ;;
esac
for c in awk cat chmod cp cut grep id mkdir od rm sha256sum tail tr uname; do
    command -v "$c" >/dev/null 2>&1 || stop "missing required command: $c"
done

HELPER="$RUN/partitioner"
tail -c "$HELPER_SIZE" "$SELF" >"$HELPER" 2>/dev/null || stop 'cannot extract the helper'
[ "$(od -An -tu1 -j4 -N1 "$HELPER" | tr -d ' \n')" = 2 ] || stop 'embedded helper is not ELF64 (file damaged?)'
[ "$(od -An -tx1 -j18 -N2 "$HELPER" | tr -d ' \n')" = b700 ] || stop 'embedded helper is not AArch64 (file damaged?)'
[ "$(sha256sum "$HELPER" | cut -d' ' -f1)" = "$HELPER_SHA256" ] || \
    stop 'helper integrity check failed; re-copy amethyst-unixnu.sh in binary mode'
chmod 700 "$HELPER" || stop 'cannot make the helper executable'

if [ "$CMD" = selftest ]; then
    "$HELPER" selftest
    exit $?
fi

# --------------------------------------------------------------------------
# Environment checks
# --------------------------------------------------------------------------
[ "$(id -u)" = 0 ] || stop 'root is required (TWRP adb shell / terminal is root)'
[ "$(getprop sys.boot_completed 2>/dev/null)" != 1 ] || \
    stop 'Android is running; reboot to recovery first'
if [ -z "$(getprop ro.twrp.version 2>/dev/null)" ] && \
   [ ! -x /sbin/recovery ] && [ ! -x /system/bin/recovery ]; then
    stop 'a TWRP-like recovery environment is required'
fi

data_mounted() {
    grep -Eq '[[:space:]]/data[[:space:]]+f2fs[[:space:]]+rw' /proc/mounts
}

on_userdata_path() {
    case "$1" in
        /data|/data/*|/sdcard|/sdcard/*|/storage/emulated*|/mnt/user*|/mnt/runtime*) return 0 ;;
    esac
    return 1
}

# The shell you typed this into must not sit inside /data or /sdcard either.
warn_holders() {
    for pid in $PPID $(cat /proc/$PPID/stat 2>/dev/null | awk '{print $4}'); do
        cwd=$(readlink /proc/$pid/cwd 2>/dev/null || true)
        if [ -n "$cwd" ] && on_userdata_path "$cwd"; then
            say "WARNING: your shell (pid $pid) is in $cwd, which is on userdata."
            say "         Apply cannot unmount /data while it is there. Exit, 'cd /', and re-run."
            return 1
        fi
    done
    return 0
}

mounted_dir() {
    awk -v d="$1" '$2 == d { found=1 } END { exit !found }' /proc/mounts
}

# Pick where reports and plans go: never userdata-backed storage.
if [ -n "$OPT_DIR" ]; then
    case "$OPT_DIR" in /*) ;; *) stop '--dir must be an absolute path' ;; esac
    WORKROOT=$OPT_DIR
elif mounted_dir /usb_otg; then
    WORKROOT=/usb_otg
elif mounted_dir /external_sd; then
    WORKROOT=/external_sd
else
    WORKROOT=$RAMDIR
fi
on_userdata_path "$WORKROOT" && stop "$WORKROOT is on userdata; use a USB OTG stick, SD card or /tmp"
BASE="$WORKROOT/Amethyst-UniXNU-Partitioner"
mkdir -p "$BASE/plans" || stop "cannot create $BASE (is it mounted read-only?)"

IN_RAM=0
case "$BASE" in "$RAMDIR"/*|/tmp/*) IN_RAM=1 ;; esac

IDENT="$RUN/identity.conf"
{
    printf 'device=%s\n' "$(getprop ro.product.device 2>/dev/null)"
    printf 'model=%s\n' "$(getprop ro.product.model 2>/dev/null)"
    serial=$(getprop ro.serialno 2>/dev/null)
    [ -n "$serial" ] || serial=$(getprop ro.boot.serialno 2>/dev/null)
    printf 'serial=%s\n' "$serial"
    twrp=$(getprop ro.twrp.version 2>/dev/null)
    if [ -n "$twrp" ]; then
        printf 'recovery=twrp\ntwrp=%s\n' "$twrp"
    else
        printf 'recovery=recovery\n'
    fi
    printf 'kernel=%s\n' "$(uname -r)"
    printf 'machine=%s\n' "$(uname -m)"
    printf 'boot_completed=%s\n' "$(getprop sys.boot_completed 2>/dev/null || echo 0)"
    printf 'dt_model=%s\n' "$( { tr -d '\000' </proc/device-tree/model; } 2>/dev/null)"
    printf 'usb_config=%s\n' "$(getprop sys.usb.config 2>/dev/null)"
    printf 'usb_state=%s\n' "$(getprop sys.usb.state 2>/dev/null)"
} >"$IDENT" || stop 'cannot write the identity file'

LOG="$BASE/session-$(date +%Y%m%d-%H%M%S 2>/dev/null || echo now).log"
helper() {
    # Run the helper, show its output and keep a copy beside the reports.
    # Output streams live (apply can take minutes) and the exit code survives
    # the pipe through a file.
    say ">> partitioner $*" >>"$LOG"
    rm -f "$RUN/rc"
    if command -v tee >/dev/null 2>&1; then
        { "$HELPER" --identity "$IDENT" --base "$BASE" "$@" 2>&1; echo $? >"$RUN/rc"; } | tee -a "$LOG"
    else
        { "$HELPER" --identity "$IDENT" --base "$BASE" "$@" 2>&1; echo $? >"$RUN/rc"; }
    fi
    rc=$(cat "$RUN/rc" 2>/dev/null)
    return "${rc:-1}"
}

conf_get() {
    # conf_get key file -> value of key=value
    awk -v k="$1" 'index($0, k "=") == 1 { v = substr($0, length(k) + 2) } END { print v }' "$2"
}

newest_plan() {
    ls -1dt "$BASE"/plans/*/ 2>/dev/null | while IFS= read -r d; do
        d=${d%/}
        [ -f "$d/plan.conf" ] && { printf '%s\n' "$d"; break; }
    done
}

# --------------------------------------------------------------------------
# Steps
# --------------------------------------------------------------------------
do_inspect() {
    hr
    say 'STEP 1: read-only inspect'
    hr
    data_mounted || say 'NOTE: /data is not mounted read-write as F2FS; inspect will report that.'
    report="$BASE/inspect-$(date +%Y%m%d-%H%M%S 2>/dev/null || echo now).txt"
    helper inspect --out "$report" || stop 'inspect failed; see the message above'
    say
    say "Report: $report"
    if grep -q '^RESULT: SUPPORTED' "$report"; then
        say 'RESULT: SUPPORTED'
        return 0
    fi
    say 'RESULT: UNSUPPORTED - blockers:'
    grep 'UNSUPPORTED' "$report" | sed 's/^/  /'
    say
    say '[fixable-in-recovery] items can be cleared (unmount /metadata, decrypt and'
    say 'mount /data, shut Android down cleanly). [hard] items mean this layout cannot be split.'
    return 1
}

do_plan() {
    hr
    say 'STEP 2: create a plan (no partition or filesystem writes)'
    hr
    data_mounted || stop 'decrypt and mount /data read-write first (Mount menu in recovery)'
    size=$OPT_SIZE
    if [ -z "$size" ]; then
        ask 'Size of the new unixnu partition in GiB' 16
        size=$REPLY
    fi
    case "$size" in ''|*[!0-9.]*|*.*.*|.*) stop "invalid size '$size'" ;; esac
    reserve=${OPT_RESERVE:-1024}
    case "$reserve" in ''|*[!0-9]*) stop "invalid reserve '$reserve'" ;; esac

    PLAN_DIR="$BASE/plans/plan-$(date +%Y%m%d-%H%M%S 2>/dev/null || echo $$)"
    req="$RUN/request-plan.conf"
    {
        printf 'mode = plan\n'
        printf 'size_gib = %s\n' "$size"
        printf 'reserve_mib = %s\n' "$reserve"
        printf 'plan_dir = %s\n' "$PLAN_DIR"
    } >"$req"
    helper plan --request "$req" || stop 'plan refused or failed; nothing was written to the disk'
    if [ "$IN_RAM" = 1 ]; then
        say
        say "NOTE: the plan is in RAM ($PLAN_DIR). It is lost on reboot, so post-reboot"
        say '      verify/resume is not possible. A USB OTG stick is safer (--dir /usb_otg).'
    fi
}

do_apply() {
    hr
    say 'STEP 3: APPLY - shrinks userdata (F2FS) and writes the GPT'
    hr
    [ -n "$PLAN_DIR" ] || PLAN_DIR=$(newest_plan)
    [ -n "$PLAN_DIR" ] && [ -f "$PLAN_DIR/plan.conf" ] || \
        stop "no plan found under $BASE/plans; run the plan step first or pass --plan DIR"
    on_userdata_path "$PLAN_DIR" && stop "plan $PLAN_DIR is on userdata; copy it to OTG/SD/tmp"
    data_mounted || stop 'decrypt and mount /data read-write first'
    warn_holders || ask_yes 'Continue anyway?' || stop 'cancelled; nothing was changed'

    confirm=$(conf_get confirm "$PLAN_DIR/plan.conf")
    [ -n "$confirm" ] || stop "cannot read the confirmation phrase from $PLAN_DIR/plan.conf"
    say
    [ -f "$PLAN_DIR/plan.txt" ] && cat "$PLAN_DIR/plan.txt"
    say
    say "Plan:    $PLAN_DIR"
    say "Confirm: $confirm"
    say
    say '!! This moves file data inside userdata and rewrites both GPT copies.'
    say '!! There is no rollback. Restoring an old GPT cannot undo the F2FS shrink.'
    say '!! Keep the phone on the charger and do not interrupt it.'
    say
    ask 'Type APPLY in capitals to continue, anything else to cancel' ''
    [ "$REPLY" = APPLY ] || stop 'cancelled; nothing was changed'

    if helper apply --plan "$PLAN_DIR" --confirm "$confirm" --i-understand-data-loss; then
        say
        say 'APPLY COMPLETE.'
        say "Bundle and apply.log: $PLAN_DIR"
        say "After rebooting to recovery, check it with:"
        say "  sh amethyst-unixnu.sh verify --plan $PLAN_DIR"
        say 'unixnu is left unformatted for the UniXNU tooling.'
        return 0
    fi
    say
    say 'Apply stopped. Read-only recovery summary follows (no retry is attempted):'
    helper recover --plan "$PLAN_DIR" || true
    say
    say 'Keep this recovery session open and save the plan directory and logs.'
    say 'If the phone rebooted mid-apply, re-running apply with the same plan resumes it.'
    exit 1
}

do_readonly() {
    # verify | recover
    [ -n "$PLAN_DIR" ] || PLAN_DIR=$(newest_plan)
    [ -n "$PLAN_DIR" ] && [ -f "$PLAN_DIR/plan.conf" ] || stop "$1 needs --plan DIR (no plan found under $BASE/plans)"
    helper "$1" --plan "$PLAN_DIR"
}

# --------------------------------------------------------------------------
say "Amethyst UniXNU Partitioner $TOOL_VERSION"
say "Device: $(getprop ro.product.device 2>/dev/null) / $(getprop ro.product.model 2>/dev/null)"
say "Files:  $BASE"
say "Log:    $LOG"
[ "${AMETHYST_UNIXNU_ORIGIN:-}" ] && on_userdata_path "$AMETHYST_UNIXNU_ORIGIN" && \
    say "(Running from a RAM copy; the original on userdata is not held open.)"
[ "$IN_RAM" = 1 ] && [ -z "$OPT_DIR" ] && \
    say 'NOTE: no USB OTG stick or SD card found; using RAM. Plans are lost on reboot.'

PLAN_DIR=$OPT_PLAN
case "$CMD" in
    inspect) do_inspect ;;
    plan)    do_plan ;;
    apply)   do_apply ;;
    verify)  do_readonly verify ;;
    recover) do_readonly recover ;;
    guided)
        say
        say 'Guided mode: inspect -> plan -> apply. You will be asked before anything is written.'
        say 'Back up userdata and metadata first. Decrypt and mount /data in recovery.'
        say
        do_inspect || stop 'inspect reported UNSUPPORTED; fix the blockers above and re-run'
        say
        ask_yes 'Create a plan now?' || { say 'Stopped after inspect.'; exit 0; }
        do_plan
        say
        ask_yes 'Review the plan above. Proceed to apply?' || {
            say "Stopped after planning. Apply later with: sh amethyst-unixnu.sh apply --plan $PLAN_DIR"
            exit 0
        }
        do_apply
        ;;
esac
exit 0
__HELPER_PAYLOAD__
